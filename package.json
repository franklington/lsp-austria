{
  "name": "lsp-austria",
  "version": "1.0.0",
  "description": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/franklington/lsp-austria.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/franklington/lsp-austria/issues"
  },
  "homepage": "https://github.com/franklington/lsp-austria#readme",
  "devDependencies": {
    "concurrently": "^9.0.0",
    "http-server": "^14.1.1",
    "sass": "^1.62.0"
  },
  "scripts": {
    "dev": "concurrently \"sass --watch --update --style=expanded main.scss:main.css\" \"http-server -p 8080 -o\"",
    "prod": "sass --no-source-map --style=compressed main.scss:main.css",
    "build": "sass --no-source-map --style=compressed main.scss:main.css && mkdir -p dist && cp index.html impressum.html datenschutz.html main.css logo.svg _redirects sitemap.xml robots.txt dist/ && cp -r favicons dist/",
    "serve": "http-server -p 8080 -o"
  }
}
