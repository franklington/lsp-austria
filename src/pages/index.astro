---
import BaseLayout from '../layouts/BaseLayout.astro';
import { monthlyTopics } from '../data/monthly-topics.js';
import { services } from '../data/services.js';
import { companyProfile } from '../data/site-content.js';
import ServiceCards from '../components/ServiceCards.astro';

const officeHourLines = companyProfile.openingHours.officeLines;
---

<BaseLayout
  title="LSP Gmunden - Versicherung & Vorsorge | KFZ, Hausrat & Zulassung"
  description="LSP Gmunden: Ihr Versicherungspartner für KFZ, Hausrat, Lebensversicherung und KFZ-Zulassung. ☎ 07612/67646-0 | Bahnhofstraße 46"
  canonical="https://lsp-gmunden.at/"
>
  <Fragment slot="head">
    <meta name="keywords" content="LSP Gmunden, Versicherung Gmunden, KFZ Versicherung, Zulassungsstelle, Hausratversicherung, Lebensversicherung" />
    <meta property="og:title" content="LSP Gmunden - Versicherung & Vorsorge" />
    <meta property="og:description" content="Ihr Versicherungspartner in Gmunden für KFZ, Vorsorge und Zulassung" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://lsp-gmunden.at/" />
    <meta property="og:locale" content="de_AT" />
    <meta property="og:site_name" content="LSP Gmunden" />
    <meta property="og:image" content="https://lsp-gmunden.at/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="LSP Gmunden - Versicherung & Vorsorge" />
    <meta name="twitter:description" content="Ihr Versicherungspartner in Gmunden für KFZ, Vorsorge und Zulassung" />
    <meta name="twitter:image" content="https://lsp-gmunden.at/og-image.png" />
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "Organization",
            "@id": "https://lsp-gmunden.at/#organization",
            "name": "LSP Gmunden | Leitner • Sonntagbauer • Partner",
            "url": "https://lsp-gmunden.at/",
            "email": "agentur@lsp-austria.at",
            "telephone": "+4376126764600",
            "sameAs": ["https://www.evi.gv.at/f/276035i"]
          },
          {
            "@type": "InsuranceAgency",
            "@id": "https://lsp-gmunden.at/#insuranceagency",
            "name": "LSP Gmunden",
            "description": "Versicherungsagentur in Gmunden für KFZ, Hausrat, Lebensversicherung, Gewerbeversicherung und KFZ-Zulassung",
            "url": "https://lsp-gmunden.at/",
            "telephone": "+4376126764600",
            "email": "agentur@lsp-austria.at",
            "aggregateRating": { "@type": "AggregateRating", "ratingValue": 4.8, "reviewCount": 247 }
          }
        ]
      }
    </script>
  </Fragment>

  <section class="hero">
    <div class="container">
      <div class="hero-content">
        <h1>Versicherung & Vorsorge in Gmunden</h1>
        <p class="hero-subtitle">Persönliche Beratung für KFZ, Vorsorge und alle Versicherungsthemen. Ihr verlässlicher Partner in der Region.</p>
        <div class="hero-cta">
          <a href="/angebot" class="btn btn-large btn-primary">Angebot per E-Mail</a>
          <a href={`tel:${companyProfile.contact.phoneHref}`} class="btn btn-large btn-secondary">Jetzt anrufen</a>
        </div>
        <div class="hero-rating">
          <div class="rating-stars" aria-label="4.8 von 5 Sternen">★★★★★</div>
          <span class="rating-text">4.8/5 - 247 Bewertungen</span>
        </div>
      </div>
    </div>
  </section>

  <section class="services services--alt">
    <div class="container">
      <h2 class="section-title">So starten wir</h2>
        <div class="services-grid">
          <div class="service-card">
            <div class="service-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h18M12 3v18" /></svg>
            </div>
            <h3>1. Bedarf klären</h3>
            <p>Kurzes Erstgespräch, klare Prioritäten und ein strukturierter Überblick über Ihre Risiken.</p>
          </div>
          <div class="service-card">
            <div class="service-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l4 4L19 6" /></svg>
            </div>
            <h3>2. Optionen vergleichen</h3>
            <p>Sie erhalten nachvollziehbare Vorschläge mit verständlichen Deckungen und Kosten.</p>
          </div>
          <div class="service-card">
            <div class="service-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6z" /></svg>
            </div>
            <h3>3. Sicher entscheiden</h3>
            <p>Wir finalisieren gemeinsam mit persönlicher Beratung vor Ort in Gmunden.</p>
          </div>
      </div>
    </div>
  </section>

  <section id="services" class="services">
    <div class="container">
      <h2 class="section-title">Leistungen im Überblick</h2>
      <ServiceCards items={services} />
      <div class="hero-cta">
        <a href="/leistungen" class="btn btn-secondary">Alle Leistungen ansehen</a>
        <a href="/angebot" class="btn btn-primary">Angebot anfragen</a>
      </div>
    </div>
  </section>

  <section class="services topics-section" id="themen-teaser">
    <div class="container">
      <h2 class="section-title">Aktuelle Themen</h2>
      <p class="hero-subtitle">Aktuelle Artikel als kompakter Karten-Überblick.</p>
      <p id="themen-carousel-help" class="sr-only">Verwenden Sie die Pfeiltasten links und rechts, um durch die Artikel zu navigieren.</p>
      <div id="themen-carousel" class="flex snap-x snap-mandatory gap-4 overflow-x-auto pb-3" role="region" aria-label="Artikel-Karussell" aria-describedby="themen-carousel-help" tabindex="0">
        {monthlyTopics.map((topic) => (
          <article class="card min-w-[280px] snap-start p-6 md:min-w-[320px]">
            <p class="text-secondaryText text-sm">{topic.month}</p>
            <h3 class="text-primaryText mt-2 text-xl font-semibold">{topic.title}</h3>
            <p class="text-secondaryText mt-3">{topic.description}</p>
            <p class="mt-5">
              <a class="article-link" href={`/risikothemen/${topic.slug}`}>Artikel lesen</a>
            </p>
          </article>
        ))}
      </div>
      <div class="hero-cta">
        <a href="/themen" class="btn btn-primary">Alle Themen öffnen</a>
      </div>
    </div>
  </section>

  <section id="contact" class="contact">
    <div class="container">
      <div class="contact-grid">
        <div class="contact-info">
          <h2>Besuchen Sie uns</h2>
          <div class="contact-item">
            <strong>Adresse</strong>
            <p>
              {companyProfile.address.street}<br />
              {companyProfile.address.postalCode} {companyProfile.address.city}
            </p>
            <a href={companyProfile.mapUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm contact-route-link">
              <svg class="btn-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 12-9 12S3 17 3 10a9 9 0 1 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
              Route starten
            </a>
          </div>
          <div class="contact-item">
            <strong>Telefon</strong>
            <p><a href={`tel:${companyProfile.contact.phoneHref}`}>{companyProfile.contact.phoneDisplay}</a></p>
          </div>
          <div class="contact-item">
            <strong>E-Mail</strong>
            <p><a href={`mailto:${companyProfile.contact.email}`}>{companyProfile.contact.email}</a></p>
            <p class="contact-route-link"><a class="btn btn-secondary btn-sm" href="/angebot">Angebot per E-Mail</a></p>
          </div>
          <div class="contact-item">
            <strong>Öffnungszeiten</strong>
            <p>
              {officeHourLines[0]}<br />
              {officeHourLines[1]}
            </p>
          </div>
          <div class="contact-item">
            <strong>Zulassungsstelle</strong>
            <p>{companyProfile.openingHours.registration}</p>
          </div>
        </div>
        <div class="contact-map">
          <div class="map-embed" data-map-container data-map-src="https://www.openstreetmap.org/export/embed.html?bbox=13.7817%2C47.9228%2C13.7939%2C47.9285&amp;layer=mapnik&amp;marker=47.925358%2C13.787584">
            <div class="map-consent" data-map-consent-panel>
              <svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19l-5 2V5l5-2m0 16l6-2m-6 2V3m6 14l5 2V3l-5-2m0 16V1"></path></svg>
              <h3>Karte laden?</h3>
              <p>Für die Kartenansicht wird OpenStreetMap geladen. Dabei wird Ihre IP-Adresse an OpenStreetMap übermittelt.</p>
              <div class="map-consent-buttons">
                <button type="button" class="btn btn-primary btn-sm" data-map-consent-accept>OpenStreetMap laden</button>
                <a class="btn btn-secondary btn-sm" href="/datenschutz">Datenschutz</a>
              </div>
            </div>
          </div>
          <div class="map-navigate is-visible">
            <a href={companyProfile.mapUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">
              <svg class="btn-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19l-5 2V5l5-2m0 16l6-2m-6 2V3m6 14l5 2V3l-5-2m0 16V1"></path></svg>
              Route öffnen
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Fragment slot="scripts">
    <script is:inline>
      const MAP_CONSENT_MAX_AGE_SECONDS = 60 * 60 * 24 * 365;

      const initThemenCarousel = () => {
        const carousel = document.getElementById('themen-carousel');
        if (!carousel || carousel.dataset.initialized === 'true') return;
        carousel.dataset.initialized = 'true';
        carousel.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowRight') {
            event.preventDefault();
            carousel.scrollBy({ left: 320, behavior: 'smooth' });
          } else if (event.key === 'ArrowLeft') {
            event.preventDefault();
            carousel.scrollBy({ left: -320, behavior: 'smooth' });
          }
        });
      };

      const initMapConsent = () => {
        const mapContainer = document.querySelector('[data-map-container]');
        if (!(mapContainer instanceof HTMLElement) || mapContainer.dataset.initialized === 'true') return;
        mapContainer.dataset.initialized = 'true';

        const consentPanel = mapContainer.querySelector('[data-map-consent-panel]');
        const consentButton = mapContainer.querySelector('[data-map-consent-accept]');
        const mapSrc = mapContainer.dataset.mapSrc;
        const consentCookieName = 'lsp_map_consent';

        const hasConsent = document.cookie.split(';').some((cookie) => cookie.trim().startsWith(`${consentCookieName}=true`));
        const renderMap = () => {
          if (!mapSrc || mapContainer.querySelector('iframe')) return;
          const iframe = document.createElement('iframe');
          iframe.title = 'Karte: LSP Gmunden';
          iframe.loading = 'lazy';
          iframe.referrerPolicy = 'no-referrer-when-downgrade';
          iframe.src = mapSrc;
          mapContainer.appendChild(iframe);
          if (consentPanel instanceof HTMLElement) consentPanel.remove();
        };

        if (hasConsent) {
          renderMap();
          return;
        }

        if (consentButton instanceof HTMLElement) {
          consentButton.addEventListener('click', () => {
            const secureAttribute = window.location.protocol === 'https:' ? '; Secure' : '';
            document.cookie = `${consentCookieName}=true; Max-Age=${MAP_CONSENT_MAX_AGE_SECONDS}; Path=/; SameSite=Lax${secureAttribute}`;
            renderMap();
          });
        }
      };

      document.addEventListener('DOMContentLoaded', initThemenCarousel);
      document.addEventListener('astro:page-load', initThemenCarousel);
      document.addEventListener('DOMContentLoaded', initMapConsent);
      document.addEventListener('astro:page-load', initMapConsent);
    </script>
  </Fragment>
</BaseLayout>
