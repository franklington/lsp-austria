---
import BaseLayout from '../layouts/BaseLayout.astro';
import { monthlyTopics } from '../data/monthly-topics.js';
---

<BaseLayout
  title="LSP Gmunden - Versicherung & Vorsorge | KFZ, Hausrat & Zulassung"
  description="LSP Gmunden: Ihr Versicherungspartner für KFZ, Hausrat, Lebensversicherung und KFZ-Zulassung. ☎ 07612/67646-0 | Bahnhofstraße 46"
  canonical="https://lsp-gmunden.at/"
>
  <Fragment slot="head">
    <meta name="keywords" content="LSP Gmunden, Versicherung Gmunden, KFZ Versicherung, Zulassungsstelle, Hausratversicherung, Lebensversicherung" />
    <meta property="og:title" content="LSP Gmunden - Versicherung & Vorsorge" />
    <meta property="og:description" content="Ihr Versicherungspartner in Gmunden für KFZ, Vorsorge und Zulassung" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://lsp-gmunden.at/" />
    <meta property="og:locale" content="de_AT" />
    <meta property="og:site_name" content="LSP Gmunden" />
    <meta property="og:image" content="https://lsp-gmunden.at/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="LSP Gmunden - Versicherung & Vorsorge" />
    <meta name="twitter:description" content="Ihr Versicherungspartner in Gmunden für KFZ, Vorsorge und Zulassung" />
    <meta name="twitter:image" content="https://lsp-gmunden.at/og-image.png" />
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "Organization",
            "@id": "https://lsp-gmunden.at/#organization",
            "name": "LSP Gmunden | Leitner • Sonntagbauer • Partner",
            "url": "https://lsp-gmunden.at/",
            "email": "agentur.lsp@allianz.at",
            "telephone": "+4376126764600",
            "sameAs": ["https://www.allianz.at/de_AT/beratung/lsp.html"]
          },
          {
            "@type": "InsuranceAgency",
            "@id": "https://lsp-gmunden.at/#insuranceagency",
            "name": "LSP Gmunden",
            "description": "Versicherungsagentur in Gmunden für KFZ, Hausrat, Lebensversicherung, Gewerbeversicherung und KFZ-Zulassung",
            "url": "https://lsp-gmunden.at/",
            "telephone": "+4376126764600",
            "email": "agentur.lsp@allianz.at",
            "aggregateRating": { "@type": "AggregateRating", "ratingValue": "4.8", "reviewCount": "247" }
          }
        ]
      }
    </script>
  </Fragment>

  <section class="hero">
    <div class="container">
      <div class="hero-content">
        <h1>Versicherung in Gmunden — persönlich, schnell, klar</h1>
        <p class="hero-subtitle">Wir beraten Familien, Selbstständige und Unternehmen zu passenden Lösungen ohne komplizierte Umwege.</p>
        <div class="hero-cta">
          <a href="#contact" class="btn btn-large btn-primary">Jetzt beraten lassen</a>
          <a href="/themen" class="btn btn-large btn-secondary">Zu den Themen</a>
        </div>
        <p class="hero-note">Oder direkt anrufen: <a href="tel:+43761267646-0">07612/67646-0</a></p>
      </div>
    </div>
  </section>

  <section class="services">
    <div class="container">
      <h2 class="section-title">So starten wir</h2>
      <div class="services-grid">
        <div class="service-card">
          <h3>1. Bedarf klären</h3>
          <p>Kurzes Erstgespräch, klare Prioritäten und ein strukturierter Überblick über Ihre Risiken.</p>
        </div>
        <div class="service-card">
          <h3>2. Optionen vergleichen</h3>
          <p>Sie erhalten nachvollziehbare Vorschläge mit verständlichen Deckungen und Kosten.</p>
        </div>
        <div class="service-card">
          <h3>3. Sicher entscheiden</h3>
          <p>Wir finalisieren gemeinsam mit persönlicher Beratung vor Ort in Gmunden.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="services" class="services">
    <div class="container">
      <h2 class="section-title">Leistungen im Überblick</h2>
      <div class="services-grid">
        <div class="service-card">
          <h3>KFZ & Zulassung</h3>
          <p>Haftpflicht, Kasko, Kennzeichen und Zulassung aus einer Hand.</p>
        </div>
        <div class="service-card">
          <h3>Wohnen & Recht</h3>
          <p>Haushalt, Eigenheim und Rechtsschutz für den Alltag.</p>
        </div>
        <div class="service-card">
          <h3>Vorsorge & Gesundheit</h3>
          <p>Unfall, Krankenversicherung und langfristige Absicherung.</p>
        </div>
        <div class="service-card">
          <h3>Unternehmen</h3>
          <p>Gewerbe, Haftpflicht und Cyber-Schutz für Betriebe.</p>
        </div>
      </div>
      <div class="hero-cta">
        <a href="/leistungen" class="btn btn-secondary">Alle Leistungen ansehen</a>
      </div>
    </div>
  </section>

  <section class="services" id="themen-teaser">
    <div class="container">
      <h2 class="section-title">Aktuelle Themen</h2>
      <p class="hero-subtitle">Kurze Teaser als Karten — nach rechts wischen für weitere Artikel.</p>
      <div class="flex snap-x snap-mandatory gap-4 overflow-x-auto pb-3">
        {monthlyTopics.map((topic) => (
          <article class="card min-w-[280px] snap-start p-6 md:min-w-[320px]">
            <p class="text-secondaryText text-sm">{topic.month}</p>
            <h3 class="text-primaryText mt-2 text-xl font-semibold">{topic.title}</h3>
            <p class="text-secondaryText mt-3">{topic.description}</p>
            <p class="mt-5">
              <a class="btn btn-secondary btn-sm" href={`/risikothemen/${topic.slug}`}>Artikel lesen</a>
            </p>
          </article>
        ))}
      </div>
      <div class="hero-cta">
        <a href="/themen" class="btn btn-primary">Alle Themen öffnen</a>
      </div>
    </div>
  </section>

  <section id="contact" class="contact">
    <div class="container">
      <div class="contact-grid">
        <div class="contact-info">
          <h2>Besuchen Sie uns</h2>
          <div class="contact-item">
            <strong>Adresse</strong>
            <p>
              Bahnhofstraße 46<br />
              4810 Gmunden
            </p>
            <a href="https://maps.apple.com/?address=Bahnhofstra%C3%9Fe+46,+4810+Gmunden&ll=47.925358,13.787584&q=LSP+Gmunden" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm contact-route-link">
              Route starten
            </a>
          </div>
          <div class="contact-item">
            <strong>Telefon</strong>
            <p><a href="tel:+43761267646-0">07612/67646-0</a></p>
          </div>
          <div class="contact-item">
            <strong>E-Mail</strong>
            <p><a href="mailto:agentur.lsp@allianz.at">agentur.lsp@allianz.at</a></p>
          </div>
          <div class="contact-item">
            <strong>Öffnungszeiten</strong>
            <p>
              Mo - Do: 07:30 - 12:30 &amp; 13:30 - 16:30<br />
              Fr: 07:30 - 13:00
            </p>
          </div>
          <div class="contact-item">
            <strong>Zulassungsstelle</strong>
            <p>Mo - Fr: 08:00 - 12:00</p>
          </div>
        </div>
        <div class="contact-map">
          <div class="map-embed">
            <iframe
              title="Karte: LSP Gmunden"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              src="https://www.openstreetmap.org/export/embed.html?bbox=13.7817%2C47.9228%2C13.7939%2C47.9285&amp;layer=mapnik&amp;marker=47.925358%2C13.787584"
            ></iframe>
          </div>
          <div class="map-navigate" style="display:flex;">
            <a href="https://maps.apple.com/?address=Bahnhofstra%C3%9Fe+46,+4810+Gmunden&ll=47.925358,13.787584&q=LSP+Gmunden" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">Route öffnen</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
