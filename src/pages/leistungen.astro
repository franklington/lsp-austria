---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCards from '../components/ServiceCards.astro';
import { services } from '../data/services.js';
---

<BaseLayout
  title="Leistungen – LSP Gmunden"
  description="Leistungen von LSP Gmunden: KFZ, Zulassung, Wohnen, Vorsorge, Gesundheit und Gewerbeversicherungen."
  canonical="https://lsp-gmunden.at/leistungen"
>
  <section class="services">
    <div class="container">
      <h1 class="section-title">Unsere Leistungen</h1>
      <ServiceCards items={services} />
      <div class="hero-cta">
        <a href="/angebot" class="btn btn-large btn-primary">Angebot per E-Mail</a>
        <a href="/#contact" class="btn btn-large btn-secondary">Kontakt ansehen</a>
      </div>
    </div>
  </section>
</BaseLayout>
