---
import BaseLayout from '../layouts/BaseLayout.astro';
import { companyProfile } from '../data/site-content.js';

const officeHourLines = companyProfile.openingHours.officeLines;
const shareholders = companyProfile.legal.shareholders;
---

<BaseLayout
  title="Impressum – LSP Gmunden"
  description="Impressum der LSP Consulting GmbH, Bahnhofstraße 46, 4810 Gmunden."
  canonical="https://lsp-gmunden.at/impressum"
  robots="noindex, nofollow"
>
  <main class="legal-page">
    <div class="container">
      <div class="legal-content">
        <h1>Impressum</h1>
        <p class="legal-meta">{companyProfile.legalEntitySummary}</p>

        <section>
          <h2>Unternehmen</h2>
          <p>
            {companyProfile.legalName}<br />
            {companyProfile.address.street}<br />
            {companyProfile.address.postalCode} {companyProfile.address.city}<br />
            {companyProfile.address.country}
          </p>
        </section>

        <section>
          <h2>Kontakt</h2>
          <p>
            Telefon: <a href={`tel:${companyProfile.contact.phoneHref}`}>{companyProfile.contact.phoneDisplay}</a><br />
            E-Mail: <a href={`mailto:${companyProfile.contact.email}`}>{companyProfile.contact.email}</a>
          </p>
        </section>

        <section>
          <h2>Rechtsform</h2>
          <p>{companyProfile.legal.companyForm}</p>
        </section>

        <section>
          <h2>Firmenbuch</h2>
          <p>
            Firmenbuchnummer: {companyProfile.legal.companyRegisterNumber}<br />
            Firmenbuchgericht: {companyProfile.legal.companyRegisterCourt}<br />
            Eintragungsdatum: {companyProfile.legal.registrationDate}<br />
            Sitz: {companyProfile.legal.registeredSeat}<br />
            Stammkapital: {companyProfile.legal.shareCapital}
          </p>
        </section>

        <section>
          <h2>Geschäftszweig</h2>
          <p>{companyProfile.legal.businessPurpose}</p>
        </section>

        <section>
          <h2>Geschäftsführung</h2>
          <p>
            {companyProfile.legal.managingDirectors[0]}<br />
            {companyProfile.legal.managingDirectors[1]}
          </p>
        </section>

        <section>
          <h2>Gesellschafter</h2>
          <p>
            {shareholders.map((shareholder) => (
              <>
                {shareholder.name} ({shareholder.ownershipPercent}%)<br />
              </>
            ))}
          </p>
        </section>

        <section>
          <h2>Vertretung</h2>
          <p>{companyProfile.legal.representation}</p>
        </section>

        <section>
          <h2>Aufsichtsbehörde</h2>
          <p>
            {companyProfile.legal.supervisoryAuthority.name}<br />
            {companyProfile.legal.supervisoryAuthority.address}<br />
            <a href={companyProfile.legal.supervisoryAuthority.url} target="_blank" rel="noopener noreferrer">www.fma.gv.at</a>
          </p>
        </section>

        <section>
          <h2>Öffnungszeiten</h2>
          <p>
            {officeHourLines[0]}<br />
            {officeHourLines[1]}<br />
            Zulassungsstelle: {companyProfile.openingHours.registration}
          </p>
        </section>

        <section>
          <h2>Anwendbares Recht</h2>
          <p>Es gilt österreichisches Recht. Gerichtsstand ist Gmunden.</p>
        </section>

        <section>
          <h2>Haftung</h2>
          <p>Die Inhalte dieser Website wurden mit größtmöglicher Sorgfalt erstellt. Für die Richtigkeit, Vollständigkeit und Aktualität übernehmen wir keine Gewähr. Als Diensteanbieter sind wir für eigene Inhalte nach § 18 ECG verantwortlich.</p>
        </section>
      </div>
    </div>
  </main>
</BaseLayout>
