---
import BaseLayout from '../layouts/BaseLayout.astro';
import { monthlyTopics } from '../data/monthly-topics.js';
---

<BaseLayout
  title="Themen – LSP Gmunden"
  description="Themen-Blog von LSP Gmunden mit monatlichen Beiträgen zu Risiken, Vorsorge und Versicherung."
  canonical="https://lsp-gmunden.at/themen"
>
  <section class="services">
    <div class="container">
      <h1 class="section-title">Themen</h1>
      <p class="hero-subtitle">Kurze Einstiege zu aktuellen Versicherungsfragen. Jeder Beitrag führt in eine FAQ-Ansicht mit kompakten Antworten.</p>
      <div class="services-grid">
        {monthlyTopics.map((topic) => (
          <article class="service-card">
            <h3>{topic.month}: {topic.title}</h3>
            <p>{topic.description}</p>
            <p><a class="article-link" href={`/risikothemen/${topic.slug}`}>Artikel lesen</a></p>
          </article>
        ))}
      </div>
      <div class="hero-cta topics-cta">
        <a href="/angebot" class="btn btn-primary">Angebot per E-Mail</a>
      </div>
    </div>
  </section>
</BaseLayout>
