---
import BaseLayout from '../layouts/BaseLayout.astro';
import { monthlyTopics } from '../data/monthly-topics.js';
---

<BaseLayout
  title="Themen – LSP Gmunden"
  description="Themen-Blog von LSP Gmunden mit monatlichen Beiträgen zu Risiken, Vorsorge und Versicherung."
  canonical="https://lsp-gmunden.at/themen"
>
  <section class="services">
    <div class="container">
      <h1 class="section-title">Aktuelle Themen</h1>
      <p class="hero-subtitle" style="max-width: 640px; margin-left: auto; margin-right: auto;">
        Jeden Monat beleuchten wir ein Versicherungsthema, das für die Region besonders relevant ist – mit regionalem Kontext, kompakten Grundlagen und häufigen Fragen.
      </p>
      <div class="topics-grid">
        {monthlyTopics.map((topic) => (
          <article class="topic-card">
            <span class="topic-card-month">{topic.month}</span>
            <h3 class="topic-card-title">{topic.title}</h3>
            <p class="topic-card-desc">{topic.description}</p>
            <a class="article-link" href={`/risikothemen/${topic.slug}`}>Artikel lesen</a>
          </article>
        ))}
      </div>
      <div class="hero-cta topics-cta">
        <a href="/angebot" class="btn btn-primary">Angebot per E-Mail</a>
      </div>
    </div>
  </section>
</BaseLayout>
