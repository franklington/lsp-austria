---
const currentPath = Astro.url.pathname;
const navLinks = [
  { label: 'Start', href: '/' },
  { label: 'Leistungen', href: '/leistungen' },
  { label: 'Themen', href: '/themen' },
  { label: 'Kontakt', href: '/#contact' }
];

const isHomepage = currentPath === '/' || currentPath === '/index.html';
const isActive = (href) => {
  if (href.startsWith('/#')) return currentPath === '/';
  return currentPath === href || (href !== '/' && currentPath.startsWith(`${href}/`));
};
---

<nav
  class={`w-full h-20 flex flex-col justify-center items-center fixed z-[1200] transition-all duration-300 ${!isHomepage ? 'bg-bgDark1/70 backdrop-blur-[15px]' : ''}`}
  id="main-nav"
  data-homepage={isHomepage ? 'true' : 'false'}
  aria-label="Main navigation"
>
  <div class="relative z-[1201] flex w-11/12 items-center justify-between xl:w-10/12 2xl:w-7xl">
    <a href="/" aria-label="Startseite">
      <div class="flex grow basis-0 items-center justify-start gap-3">
        <img src="/logo.svg" alt="LSP Logo" width="120" height="32" />
        <span class="font-['Inter'] text-base font-bold text-white hidden sm:inline">LSP Gmunden</span>
      </div>
    </a>
    <div class="hidden h-full pl-12 lg:flex">
      {navLinks.map(({ href, label }) => (
        <a
          class="relative flex h-20 cursor-pointer items-center px-4 text-2xl leading-6 font-normal text-white transition duration-200 hover:text-indigo-200 focus-visible:outline-offset-[-4px] lg:text-base lg:font-medium 2xl:px-6"
          href={href}
          aria-current={isActive(href) ? 'page' : undefined}
        >
          {label}
          {isActive(href) && <span class="bg-secondaryColor absolute right-0 bottom-0 left-0 h-0.5 rounded-full" />}
        </a>
      ))}
    </div>
    <div class="hidden grow basis-0 justify-end lg:flex">
      <a class="outlined-button flex pt-2 pr-6 pb-2 pl-6" href="tel:+43761267646-0" aria-label="Anrufen">
        07612/67646-0
      </a>
    </div>
    <button
      class="border-mainBorder hover:bg-bgDark2 flex cursor-pointer flex-col rounded-md border border-solid px-2 py-3 lg:hidden"
      id="mobile-menu-toggle"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <div class="mb-1 h-0.5 w-5 bg-gray-500"></div>
      <div class="mb-1 h-0.5 w-5 bg-gray-500"></div>
      <div class="h-0.5 w-5 bg-gray-500"></div>
    </button>
  </div>
  <div class="fixed inset-0 top-20 z-[1190] hidden bg-black/50 lg:hidden" id="mobile-menu-overlay"></div>
  <div
    class="bg-bgDark1 border-bgDark3 absolute top-4 left-0 z-[1200] mt-16 hidden w-full flex-col items-center gap-8 border-y border-solid pt-10 pb-10 lg:hidden"
    id="mobile-menu"
  >
    {navLinks.map(({ label, href }) => (
      <a class="mobile-nav-link mr-4 ml-4 h-full cursor-pointer pt-2 text-2xl leading-6 font-normal text-white transition duration-300 hover:scale-110 lg:text-base lg:font-medium 2xl:mr-6 2xl:ml-6" href={href}>
        {label}
      </a>
    ))}
    <a class="outlined-button flex pt-2 pr-6 pb-2 pl-6" href="tel:+43761267646-0" aria-label="Anrufen">
      07612/67646-0
    </a>
  </div>
</nav>

<script is:inline>
  const initNavbar = () => {
    const toggle = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const overlay = document.getElementById('mobile-menu-overlay');
    const nav = document.getElementById('main-nav');
    if (!toggle || !menu || !overlay || !nav) return;
    if (nav.dataset.initialized === 'true') return;
    nav.dataset.initialized = 'true';

    const isHomepage = nav.dataset.homepage === 'true';
    const updateNavBackground = () => {
      if (!isHomepage) return;
      if (window.scrollY > 50) {
        nav.classList.add('bg-bgDark1/70', 'backdrop-blur-[15px]');
      } else {
        nav.classList.remove('bg-bgDark1/70', 'backdrop-blur-[15px]');
      }
    };

    if (isHomepage) {
      updateNavBackground();
      window.addEventListener('scroll', updateNavBackground);
    }

    const openMenu = () => {
      menu.classList.remove('hidden');
      menu.classList.add('flex');
      overlay.classList.remove('hidden');
      overlay.classList.add('block');
      toggle.setAttribute('aria-expanded', 'true');
    };

    const closeMenu = () => {
      menu.classList.add('hidden');
      menu.classList.remove('flex');
      overlay.classList.add('hidden');
      overlay.classList.remove('block');
      toggle.setAttribute('aria-expanded', 'false');
    };

    toggle.addEventListener('click', () => {
      const isOpen = menu.classList.contains('flex');
      if (isOpen) closeMenu();
      else openMenu();
    });

    overlay.addEventListener('click', closeMenu);
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 1024) closeMenu();
    });

    document.querySelectorAll('.mobile-nav-link').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.classList.contains('flex')) {
        closeMenu();
        toggle.focus();
      }
    });
  };

  initNavbar();
  document.addEventListener('DOMContentLoaded', initNavbar);
  document.addEventListener('astro:page-load', initNavbar);
</script>
