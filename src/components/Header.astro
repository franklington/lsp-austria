---
import { companyProfile } from '../data/site-content.js';

const currentPath = Astro.url.pathname;
const navLinks = [
  { label: 'Leistungen', href: '/leistungen' },
  { label: 'Themen', href: '/themen' },
  { label: 'Kontakt', href: '/#contact' }
];

const isHomepage = currentPath === '/' || currentPath === '/index.html';
const isActive = (href) => {
  if (href.startsWith('/#')) return currentPath === '/';
  return currentPath === href || (href !== '/' && currentPath.startsWith(`${href}/`));
};
---

<nav
  class="w-full h-20 flex flex-col justify-center items-center fixed z-[1200] transition-all duration-300"
  id="main-nav"
  data-homepage={isHomepage ? 'true' : 'false'}
  aria-label="Main navigation"
>
  <div class="relative z-[1203] flex w-11/12 items-center justify-between xl:w-10/12 2xl:w-7xl">
    <a href="/" aria-label="Startseite">
      <div class="flex grow basis-0 items-center justify-start gap-3">
        <img src="/logo.svg" alt="LSP Logo" width="120" height="32" />
        <span class="font-['Inter'] text-base font-bold text-white hidden sm:inline">LSP Gmunden</span>
      </div>
    </a>
    <div class="hidden h-full pl-12 lg:flex">
      {navLinks.map(({ href, label }) => (
        <a
          class="relative flex h-20 cursor-pointer items-center px-4 text-2xl leading-6 font-normal text-white transition duration-200 hover:text-gray-300 focus-visible:outline-offset-[-4px] lg:text-base lg:font-medium 2xl:px-6"
          href={href}
          aria-current={isActive(href) ? 'page' : undefined}
        >
          {label}
          {isActive(href) && <span class="bg-secondaryColor absolute right-0 bottom-0 left-0 h-0.5 rounded-full" />}
        </a>
      ))}
    </div>
    <div class="hidden grow basis-0 justify-end lg:flex">
      <a class="outlined-button flex items-center gap-2 pt-2 pr-6 pb-2 pl-6" href="/angebot" aria-label="Angebot per E-Mail">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg>
        Angebot per E-Mail
      </a>
    </div>
    <button
      class="mobile-menu-toggle border-mainBorder hover:bg-bgDark2 relative z-[1204] flex h-11 w-11 cursor-pointer items-center justify-center rounded-md border border-solid lg:hidden"
      id="mobile-menu-toggle"
      aria-label="Menü öffnen"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="sr-only">Menü</span>
      <span class="mobile-menu-line"></span>
      <span class="mobile-menu-line"></span>
      <span class="mobile-menu-line"></span>
    </button>
  </div>
  <div class="fixed inset-0 z-[1190] hidden bg-black/50 backdrop-blur-sm lg:hidden" id="mobile-menu-overlay"></div>
  <div
    class="bg-bgDark1/95 fixed inset-0 z-[1201] hidden w-full flex-col items-center justify-start gap-8 px-6 pt-24 pb-24 backdrop-blur-xl lg:hidden"
    id="mobile-menu"
  >
    <a href="/" class="mb-1">
      <img src="/logo.svg" alt="LSP Logo" width="140" height="36" />
    </a>
    <div class="mobile-menu-links flex w-full max-w-xs flex-col items-center gap-2">
    {navLinks.map(({ label, href }) => (
      <a class="mobile-nav-link h-full cursor-pointer py-2 text-3xl leading-8 font-medium text-white transition duration-300 hover:text-gray-300" href={href}>
        {label}
      </a>
    ))}
    </div>
    <a class="outlined-button flex items-center gap-2 pt-2 pr-6 pb-2 pl-6" href={`mailto:${companyProfile.contact.email}`} aria-label="Angebot per E-Mail">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg>
      Angebot per E-Mail
    </a>
    <a class="outlined-button flex items-center gap-2 pt-2 pr-6 pb-2 pl-6" href={`tel:${companyProfile.contact.phoneHref}`} aria-label="Anrufen">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.11 4.18 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.72c.12.89.33 1.76.63 2.59a2 2 0 0 1-.45 2.11L8 9.91a16 16 0 0 0 6.09 6.09l1.49-1.28a2 2 0 0 1 2.11-.45c.83.3 1.7.51 2.59.63A2 2 0 0 1 22 16.92z"></path></svg>
      {companyProfile.contact.phoneDisplay}
    </a>
  </div>
</nav>

<script is:inline>
  const NAV_CONTROLLERS_KEY = Symbol.for('lsp.navControllers');

  const initNavbar = () => {
    const toggle = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const overlay = document.getElementById('mobile-menu-overlay');
    const nav = document.getElementById('main-nav');
    if (!toggle || !menu || !overlay || !nav) return;
    const navControllers = window[NAV_CONTROLLERS_KEY] || (window[NAV_CONTROLLERS_KEY] = new WeakMap());
    const existingController = navControllers.get(nav);
    if (existingController) existingController.abort();
    const controller = new AbortController();
    navControllers.set(nav, controller);
    const { signal } = controller;

    const updateNavBackground = () => {
      if (window.scrollY > 24) {
        nav.classList.add('bg-bgDark1/70', 'backdrop-blur-[15px]');
      } else {
        nav.classList.remove('bg-bgDark1/70', 'backdrop-blur-[15px]');
      }
    };

    updateNavBackground();
    window.addEventListener('scroll', updateNavBackground, { signal });

    const openMenu = () => {
      menu.classList.remove('hidden');
      menu.classList.add('flex');
      overlay.classList.remove('hidden');
      overlay.classList.add('block');
      toggle.classList.add('is-open');
      document.body.classList.add('overflow-hidden');
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Menü schließen');
      const firstLink = menu.querySelector('a');
      if (firstLink instanceof HTMLElement) firstLink.focus();
    };

    const closeMenu = () => {
      menu.classList.add('hidden');
      menu.classList.remove('flex');
      overlay.classList.add('hidden');
      overlay.classList.remove('block');
      toggle.classList.remove('is-open');
      document.body.classList.remove('overflow-hidden');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Menü öffnen');
    };

    toggle.addEventListener('click', () => {
      const isOpen = menu.classList.contains('flex');
      if (isOpen) closeMenu();
      else openMenu();
    }, { signal });

    overlay.addEventListener('click', closeMenu, { signal });
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 1024) closeMenu();
    }, { signal });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMenu, { signal });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.classList.contains('flex')) {
        closeMenu();
        toggle.focus();
      }
    }, { signal });
  };

  document.addEventListener('DOMContentLoaded', initNavbar);
  document.addEventListener('astro:page-load', initNavbar);
</script>
